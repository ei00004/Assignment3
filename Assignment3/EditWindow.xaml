<Window x:Class="Assignment3.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment3"
        mc:Ignorable="d"
        Title="EditWindow" Height="450" Width="800">
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="10">
            <StackPanel Width="250" VerticalAlignment="Center" Margin="10">
                <Label x:Name="label_firstNameInput" Content="_First Name:" Target="{Binding ElementName=txtbx_firstNameInput}" TabIndex="1"/>
                <TextBox x:Name="txtbx_firstNameInput" TabIndex="2">John</TextBox>
            </StackPanel>
            <StackPanel Width="250" VerticalAlignment="Center" Margin="10">
                <Label x:Name="label_lastNameInput" Content="_Last Name:" Target="{Binding ElementName=txtbx_lastNameInput}" TabIndex="3"/>
                <TextBox x:Name="txtbx_lastNameInput" TabIndex="4">Doe</TextBox>
            </StackPanel>
        </StackPanel>
        <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Width="100" Margin="20">
            <StackPanel>
                <Label x:Name="label_ageInput" TabIndex="5" Content="_Age:" Target="{Binding ElementName=txtbx_isAgeInput}"/>
                <TextBox x:Name="txtbx_ageInput" TabIndex="6">35</TextBox>
            </StackPanel>
        </StackPanel>
        <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="226">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="btn_ok" Content="_OK" Width="60" Margin="25" TabIndex="6" Click="btn_ok_Click"/>
                    <Button x:Name="btn_cancel" Content="_Cancel" Width="60" Margin="25" TabIndex="7" Click="btn_cancel_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
